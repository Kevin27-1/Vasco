rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vascotreadskgm@gmail.com';
    }

    match /stock/{itemId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.brand is string
        && request.resource.data.brand.size() > 0
        && request.resource.data.qty is number
        && request.resource.data.qty >= 0
        && request.resource.data.purchasePrice is number
        && request.resource.data.purchasePrice >= 0;
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.items is list;
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
      allow delete: if isAdmin();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
